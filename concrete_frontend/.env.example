# ── Environment variables (Create React App) ─────────────────────────────
# Copy to .env for local builds, or set these in Cloudflare Pages →
# Settings → Environment variables for production.

# Google Tag Manager container ID, e.g. GTM-XXXXXXX.
# Leave EMPTY to fully disable analytics: no GTM script loads and every
# trackEvent() call is a harmless no-op. Do NOT commit the real ID here —
# set it in Cloudflare Pages env vars instead.
REACT_APP_GTM_ID=

# Disable production source maps (keeps original source private).
GENERATE_SOURCEMAP=false
